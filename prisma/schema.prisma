datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum BookingStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum CycleCategory {
  commuter
  city
  trail
  step_thru
}

model Cycle {
  id                String        @id
  name              String
  series            String
  modelCode         String        @unique @map("model_code")
  category          CycleCategory @default(city)
  dockNumber        String        @map("dock_number")
  isMaintenance     Boolean       @default(false) @map("is_maintenance")
  maintenanceReason String?       @map("maintenance_reason")
  batteryPercent    Int?          @map("battery_percent")
  hourlyRate        Decimal       @default(25.00) @map("hourly_rate") @db.Decimal(6, 2)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at")

  bookings          Booking[]
  trips             Trip[]

  @@map("cycles")
}

model Booking {
  id              String        @id
  studentId       String        @map("student_id")
  studentName     String        @map("student_name")
  bookingDate     DateTime      @map("booking_date") @db.Date
  startTime       String        @map("start_time")
  endTime         String        @map("end_time")
  durationHours   Decimal       @map("duration_hours") @db.Decimal(4, 2)
  hourlyRate      Decimal       @default(25.00) @map("hourly_rate") @db.Decimal(6, 2)
  totalPrice      Decimal       @map("total_price") @db.Decimal(8, 2)
  isSameDay       Boolean       @map("is_same_day")
  cyclePreference String        @default("ANY") @map("cycle_preference")
  assignedCycleId String?       @map("assigned_cycle_id")
  status          BookingStatus @default(PENDING_APPROVAL)
  rejectionReason String?       @map("rejection_reason")
  reviewedBy      String?       @map("reviewed_by")
  reviewedAt      DateTime?     @map("reviewed_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at")

  cycle           Cycle?        @relation(fields: [assignedCycleId], references: [id], onDelete: SetNull)

  @@index([bookingDate, status])
  @@index([studentId])
  @@map("bookings")
}

model Trip {
  id              String    @id
  bookingId       String?   @map("booking_id")
  cycleId         String    @map("cycle_id")
  riderId         String    @map("rider_id")
  riderName       String    @map("rider_name")
  startStand      String    @map("start_stand")
  endStand        String?   @map("end_stand")
  startTime       DateTime  @map("start_time")
  endTime         DateTime? @map("end_time")
  durationSeconds Int       @default(0) @map("duration_seconds")
  distanceKm      Decimal   @default(0.0) @map("distance_km") @db.Decimal(6, 2)
  fareCharged     Decimal   @default(0.0) @map("fare_charged") @db.Decimal(8, 2)
  status          String    @default("ACTIVE")
  wasLate         Boolean   @default(false) @map("was_late")
  overdueSeconds  Int       @default(0) @map("overdue_seconds")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  cycle           Cycle     @relation(fields: [cycleId], references: [id])

  @@map("trips")
}

model Wallet {
  id          String              @id
  studentId   String              @unique @map("student_id")
  studentName String              @map("student_name")
  balance     Decimal             @default(0.00) @db.Decimal(10, 2)
  currency    String              @default("INR")
  isSandbox   Boolean             @default(true) @map("is_sandbox")
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at")

  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id             String   @id
  walletId       String   @map("wallet_id")
  amount         Decimal  @db.Decimal(10, 2)
  type           String   // CREDIT, DEBIT
  category       String   // TOP_UP, RENTAL_DEBIT, REFUND
  referenceId    String?  @map("reference_id")
  idempotencyKey String?  @unique @map("idempotency_key")
  isSandbox      Boolean  @default(true) @map("is_sandbox")
  timestamp      DateTime @default(now())
  createdAt      DateTime @default(now()) @map("created_at")

  wallet         Wallet   @relation(fields: [walletId], references: [id])

  @@map("wallet_transactions")
}

model User {
  id           String   @id // userId
  userId       String   @unique @map("user_id")
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("student")
  department   String?
  semester     String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("users")
}
